{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "books-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/books/{**catch-all}"
        }
      },
      "authors-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/authors/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "languages-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/languages/{**catch-all}"
        }
      },
      "loans-route": {
        "ClusterId": "borrowing-cluster",
        "Match": {
          "Path": "/api/loans/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "borrowing-cluster": {
        "Destinations": {
          "borrowing-destination": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
